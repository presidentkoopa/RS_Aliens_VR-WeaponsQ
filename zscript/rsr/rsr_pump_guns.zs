// generated by tools/gen_pump.py (RSR-PUMP) -- do not edit by hand
// Hand-loaded shells and a hand-worked pump: per gun. Positions cm in the weapon controller's
// frame (F, L, U); hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSP_Guns abstract
{
	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		// FIXED 2026-10-23: same exact-name bug as RSR_Guns.Index -- AE_Off_NewShotgun and
		// AE_Off_YutaniShotgun derive from these two and were falling through to 0.
		if (w is 'NewShotgun_3D')	return 1;
		if (w is 'YutaniShotgun_3D')	return 2;
		return 0;
	}

	clearscope static Vector3 Grab(int i)
	{
		switch (i)
		{
		case 1:	return (41.050, 0.040, -0.410);
		case 2:	return (41.050, 0.040, -0.410);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Pull(int i)
	{
		switch (i)
		{
		case 1:	return (-1.000, -0.000, -0.000);
		case 2:	return (-1.000, -0.000, -0.000);
		}
		return (0, 0, 0);
	}

	clearscope static double Travel(int i)
	{
		switch (i)
		{
		case 1:	return 12.570;
		case 2:	return 12.570;
		}
		return 0;
	}

	clearscope static Vector3 PumpHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.000, -0.000, 0.909);
		case 2:	return (-0.000, -0.000, 0.909);
		}
		return (0, 0, 0);
	}

	clearscope static double BoltRatio(int i)
	{
		switch (i)
		{
		case 1:	return 0.000;
		case 2:	return 0.000;
		}
		return 0;
	}

	clearscope static Vector3 SupportHook(int i)
	{
		switch (i)
		{
		case 1:	return (-0.000, -0.000, 1.000);
		case 2:	return (-0.000, -0.000, 1.000);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Port(int i)
	{
		switch (i)
		{
		case 1:	return (12.197, 0.017, -1.559);
		case 2:	return (12.197, 0.017, -1.559);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Push(int i)
	{
		switch (i)
		{
		// PATCHED BY HAND 2026-10-22 (owner: as the BD22 shotgun): the shell goes up to the port, then is
		// pushed FORWARD into the tube (BD22 Push (1,0,0), Depth 6). Was straight up 4.72.
		case 1:	return (1.000, 0.000, 0.000);
		case 2:	return (1.000, 0.000, 0.000);
		}
		return (0, 0, 0);
	}

	clearscope static double Depth(int i)
	{
		switch (i)
		{
		case 1:	return 6.00;	// 2026-10-22: forward into the tube, as BD22
		case 2:	return 6.00;
		}
		return 0;
	}

	clearscope static Vector3 PortHook(int i)
	{
		switch (i)
		{
		case 1:	return (-7.037, -6.696, 2.399);
		case 2:	return (-7.037, -6.696, 2.399);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 ShellInHand(int i)
	{
		switch (i)
		{
		case 1:	return (1.801, 2.829, -1.948);
		case 2:	return (1.801, 2.829, -1.948);
		}
		return (0, 0, 0);
	}

	// VERIFIED 2026-10-23: AxisInHand and HandRot below AGREE. Pushing the shell surface's
	// principal axis (models/weapons/shotgun/m37a2.md3 surface [3], 188 verts, axis
	// (1.0000, 0.0017, -0.0044)) through the engine's chain gives elevation +57.35 deg at
	// HandRot, against the +57.53 deg this table declares. They were suspected of being a
	// BD22 value copied onto a different mesh; they are not. Do not "fix" them by re-deriving.
	clearscope static Vector3 AxisInHand(int i)
	{
		switch (i)
		{
		case 1:	return (0.537, -0.009, 0.844);	// as BD22 1.92 (its HandRot pitch is 57.5 too)
		case 2:	return (0.537, -0.009, 0.844);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandHook(int i)
	{
		switch (i)
		{
		case 1:	return (-4.468, -7.762, 12.011);
		case 2:	return (-4.468, -7.762, 12.011);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 HandRot(int i)
	{
		switch (i)
		{
		// PATCHED BY HAND 2026-10-22 (owner): the shell stood at 10 o'clock in the fist; pitch 25.117 -> 57.6
		// turns it upright (12 / 6), render-checked. AxisInHand below matches.
		case 1:	return (0.656, 57.6, 0.550);
		case 2:	return (0.656, 57.6, 0.550);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Scale(int i)
	{
		switch (i)
		{
		case 1:	return (-1.100, 1.100, 1.100);
		case 2:	return (-1.100, 1.100, 1.100);
		}
		return (0, 0, 0);
	}

	clearscope static Vector3 Offset(int i)
	{
		switch (i)
		{
		case 1:	return (0.000, -30.000, -7.000);
		case 2:	return (0.000, -30.000, -7.000);
		}
		return (0, 0, 0);
	}

	clearscope static Name SprGun(int i)
	{
		switch (i)
		{
		case 1:	return 'RSHG';
		case 2:	return 'RSJG';
		}
		return 'None';
	}

	clearscope static Name SprPart(int i)
	{
		switch (i)
		{
		case 1:	return 'RSHP';
		case 2:	return 'RSJP';
		}
		return 'None';
	}

	clearscope static Name SprWorld(int i)
	{
		switch (i)
		{
		case 1:	return 'RSHW';
		case 2:	return 'RSJW';
		}
		return 'None';
	}

	clearscope static String ReadySprite(int i)
	{
		switch (i)
		{
		case 1:	return "ATSG A";
		case 2:	return "YTSG A";
		}
		return "";
	}

	clearscope static String WaitLabels(int i)
	{
		switch (i)
		{
		case 1:	return "RSP_LoadWait RSP_P1Wait RSP_P2Wait RSP_P3Wait RSP_Kick";
		case 2:	return "RSP_LoadWait RSP_P1Wait RSP_P2Wait RSP_P3Wait RSP_Kick";
		}
		return "";
	}

	clearscope static String SndShell(int i)
	{
		switch (i)
		{
		case 1:	return "SHELLIN";
		case 2:	return "SHELLIN";
		}
		return "";
	}

	clearscope static int ChanShell(int i)
	{
		switch (i)
		{
		case 1:	return 5;
		case 2:	return 5;
		}
		return 0;
	}

	clearscope static String SndBack(int i)
	{
		switch (i)
		{
		case 1:	return "STGNPUMP";
		case 2:	return "STGNPUMP";
		}
		return "";
	}

	clearscope static int ChanBack(int i)
	{
		switch (i)
		{
		case 1:	return 5;
		case 2:	return 5;
		}
		return 0;
	}

	// FILLED 2026-10-23: the pump's FORWARD stroke was silent (SndBack above was already
	// STGNPUMP). BD22 gives its two shotguns separate back and forward sounds; the TC has only
	// the one pump sound, so both strokes use it. ChanFwd is 0 while ChanBack is 5, so the
	// forward stroke does not cut the back stroke short.
	// No double-up: the states that play STGNPUMP themselves (RSP_P1Stock / RSP_P1BStock) are
	// the non-VR fallback animations, which do not run while the hand works the pump.
	clearscope static String SndFwd(int i)
	{
		switch (i)
		{
		case 1:	return "STGNPUMP";
		case 2:	return "STGNPUMP";
		}
		return "";
	}

	clearscope static int ChanFwd(int i)
	{
		switch (i)
		{
		case 1:	return 0;
		case 2:	return 0;
		}
		return 0;
	}

	// FILLED 2026-10-23: the spent shell thrown out of the port had no landing sound. Read as the
	// dropped shell's BounceSound (rsr_pump.zs:608), so a $random alias is fine. Our own
	// RS_Ballistics casing set, carried in and aliased in SNDINFO.rsr.
	clearscope static String SndLand(int i)
	{
		switch (i)
		{
		case 1:	return "rsr/shelldrop";
		case 2:	return "rsr/shelldrop";
		}
		return "";
	}

	// PORTED 2026-10-22 (rsr_pump.zs 1.92 InsertWanted / feedOK): what is in the tube, and how much it holds
	clearscope static String Loaded(int i)
	{
		// FIXED 2026-10-23: the two shotguns do NOT share a tube counter. The TC gives every
		// Yutani variant its own, and the rest of the pack already honours that (counter.zs,
		// pumpgl.zs and rsr_guns.zs all use YPulseLoaded / YSmartLoaded for the Yutani rifle
		// and smartgun, and MagAmmo() below already said YShotgunLoaded). This row was the one
		// place that merged them, so the hand-fed shells landed in the Colonial gun's tube and
		// the Yutani shotgun could never fire what you loaded into it.
		switch (i)
		{
		case 1:	return "ShotgunLoaded";
		case 2:	return "YShotgunLoaded";
		}
		return "";
	}

	clearscope static int Cap(int i)
	{
		return i == 1 || i == 2 ? 8 : 0;
	}

	clearscope static String Reserve(int i)
	{
		switch (i)
		{
		case 1:	return "AliensShell";
		case 2:	return "AliensShell";
		}
		return "";
	}

	clearscope static String MagAmmo(int i)
	{
		switch (i)
		{
		case 1:	return "ShotgunLoaded";
		case 2:	return "YShotgunLoaded";
		}
		return "";
	}

	clearscope static int EjectFrames(int i)
	{
		switch (i)
		{
		case 1:	return 0;
		case 2:	return 0;
		}
		return 0;
	}

	// the set's own ejected shell, frame k (V+): its place on the gun in the ready pose
	clearscope static Vector3 EjectHook(int i, int k)
	{
		return (0, 0, 0);
	}
}
