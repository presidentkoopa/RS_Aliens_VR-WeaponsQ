		case 5:	return "PistolLoaded";
		case 6:	return "SynthLoaded";
		case 7:	return "YPistolLoaded";
		case 8:	return "YPulseLoaded";
		case 9:	return "YSmartLoaded";
		case 10:	return "YutanithrowerLoaded";
		}
		return "";
	}

	clearscope static String NoMag(int i)
	{
		switch (i)
		{
		case 1:	return "RSR_NoMag_M4A3Pistol";
		case 2:	return "RSR_NoMag_PulseRifle";
		case 3:	return "RSR_NoMag_Smartgun";
		case 4:	return "RSR_NoMag_M240Flamethrower";
		case 5:	return "RSR_NoMag_MercPistol";
		case 6:	return "RSR_NoMag_SynthPistol";
		case 7:	return "RSR_NoMag_YutaniPistol";
		case 8:	return "RSR_NoMag_YutaniRifle";
		case 9:	return "RSR_NoMag_YutaniSmartgun";
		case 10:	return "RSR_NoMag_YutaniFlamer";
		}
		return "";
	}

	clearscope static String ChargeToken(int i)
	{
		switch (i)
		{
		case 1:	return "";
		case 2:	return "";
		case 3:	return "";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		case 7:	return "";
		case 8:	return "";
		case 9:	return "";
		case 10:	return "";
		}
		return "";
	}

	// '' = the engine's reload state
	clearscope static String ReloadToken(int i)
	{
		switch (i)
		{
		case 1:	return "";
		case 2:	return "";
		case 3:	return "";
		case 4:	return "";
		case 5:	return "";
		case 6:	return "";
		case 7:	return "";
		case 8:	return "";
		case 9:	return "";
		case 10:	return "";
		}
		return "";
	}

	// the gun's own frame (letter of SprGun) for a handle travel; 0 = its ready frame
	clearscope static int HandleFrame(int i, double t)
	{
		return 0;
	}
}

// every sprite the reload shows (MODELDEF.rsr), so the engine knows the names; never spawned.
// 2026-10-23: the six guns with a slide/bolt gained a third frame C -- the gun with NEITHER
// its magazine nor its slide, which is what a dry pistol looks like with the slide locked
// back and the magazine out. A frame the engine has never heard of cannot be addressed by
// psp.Frame, and MODELDEF has nothing to bind its model to, so the block below is not
// decoration: without the letter here the new MODELDEF blocks are dead.
class RSR_GunSprites : Actor
{
	States
	{
	Spawn:
		RSPM ABC 0;	// AE/M4A3Pistol_3D
		RSPP AB 0;
		RSPW A 0;
		RSLM ABC 0;	// AE/PulseRifle_3D
		RSLG A 0;	// the rifle without its launcher pump (pumpgl.zs)
		RSLQ A 0;	// the launcher pump alone
		RSLP AB 0;
		RSLW A 0;
		RSSM A 0;	// AE/Smartgun_3D
		RSSG A 0;
		RSSW A 0;
		RSFM A 0;	// AE/M240Flamethrower_3D
		RSFP A 0;
		RSFW A 0;
		RSMM ABC 0;	// AE/MercPistol_3D
		RSMP AB 0;
		RSMW A 0;
		RSYM ABC 0;	// AE/SynthPistol_3D
		RSYP AB 0;
		RSYW A 0;
		RSNM ABC 0;	// AE/YutaniPistol_3D
		RSNP AB 0;
		RSNW A 0;
		RSRM ABC 0;	// AE/YutaniRifle_3D
		RSRG A 0;
		RSRQ A 0;
		RSRP AB 0;
		RSRW A 0;
		RSVM A 0;	// AE/YutaniSmartgun_3D
		RSVP A 0;
		RSVW A 0;
		RSEM A 0;	// AE/YutaniFlamer_3D
		RSEP A 0;
		RSEW A 0;
		Stop;
	}
}

// the rounds of a magazine that was dropped, held until a magazine is home (the sets top up,
// so nothing is lost and the reserve's cap cannot eat them)
class RSR_Held_M4A3Pistol_3D : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }
class RSR_Held_PulseRifle_3D : Inventory { Default { Inventory.MaxAmount 999; +INVENTORY.UNDROPPABLE; +INVENTORY.UNTOSSABLE; +INVENTORY.QUIET } }
