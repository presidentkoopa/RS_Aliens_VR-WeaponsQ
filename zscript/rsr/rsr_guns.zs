// generated by team/reload/tools/gen_rsr.py -- do not edit by hand
// Real VR reload: per gun. Positions cm in the weapon controller's frame (F, L, U);
// hooks are ModifyBobLayer3D translations for the gun's own MODELDEF placement.

class RSR_Guns abstract
{
	clearscope static int Count() { return 10; }

	clearscope static int Index(Weapon w)
	{
		if (!w)
			return 0;
		Name n = w.GetClassName();
		if (n == 'M4A3Pistol_3D')	return 1;
		if (n == 'PulseRifle_3D')	return 2;
		if (n == 'Smartgun_3D')	return 3;
		if (n == 'M240Flamethrower_3D')	return 4;
		if (n == 'MercPistol_3D')	return 5;
		if (n == 'SynthPistol_3D')	return 6;
		if (n == 'YutaniPistol_3D')	return 7;
		if (n == 'YutaniRifle_3D')	return 8;
		if (n == 'YutaniSmartgun_3D')	return 9;
		if (n == 'YutaniFlamer_3D')	return 10;
		return 0;
	}

	// the magazine's top, seated
	clearscope static Vector3 Well(int i)
	{
		switch (i)
		{
		case 1:	return (-3.410, 0.010, -2.160);
		case 2:	return (8.790, 0.010, -8.410);
		case 3:	return (6.610, 9.030, -5.200);
		case 4:	return (22.170, -0.190, -0.220);
		case 5:	return (-3.410, 0.010, -2.160);
		case 6:	return (-3.410, 0.010, -2.160);
		case 7:	return (-3.410, 0.010, -2.160);
		case 8:	return (8.790, 0.010, -8.410);
		case 9:	return (6.610, 9.030, -5.200);
		case 10:	return (22.170, -0.190, -0.220);
		}
		return (0, 0, 0);
	}

