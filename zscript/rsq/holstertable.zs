// Body holsters: reach to where the weapon hangs and take it.
// Generated by tool/hands/ae_holster_gen.py -- do not edit by hand.
//
// Seven slots, seven places, no radial menu. Offsets are centimetres in
// the player's YAW frame (F forward, L left, U up from the view): yaw
// only, because a holster that followed head pitch would swing away as
// you looked down at it.
//
// 2026-10-22 (patched in place, ae_holster_gen.py is not in the kit): THE GIANT
// BOX. MODELDEF.holster copies each gun's pickup block (Scale 3.5, 2.8, 6.0 ...),
// but those numbers are written against the TC's weapon ACTORS, which all carry
// Scale 0.15 (pistol XScale 0.15 / YScale 0.17, satchel 0.1): the engine multiplies
// the model scale by the actor's. A ghost at the default actor scale 1.0 was
// therefore drawn TEN TIMES too big -- a 120-unit satchel crate and a 110-unit
// pistol hung on the player's hip, with the camera inside them. Verified on the
// Linux QuestZDoom 17.3 rig (quest_test_rig): the world vanished behind the
// ghosts with ae_holsters 1 and came back with ae_holsters 0. Each ghost now
// carries its weapon's actor scale, so it draws exactly as that gun's floor pickup.

class AE_HolsterGhost : Actor
{
	Default
	{
		+NOINTERACTION; +NOBLOCKMAP; +NOGRAVITY; +NOCLIP;
		+DONTSPLASH; +NOTELEPORT;
		RenderStyle "Normal";
	}
	States { Spawn: TNT1 A -1; Stop; }
}

class AE_Holster_Pistol : AE_HolsterGhost
{
	Default { XScale 0.15; YScale 0.17; }
	States { Spawn: HLPI A -1; Stop; }
}

class AE_Holster_Knife : AE_HolsterGhost
{
	Default { Scale 0.3468; }
	States { Spawn: HLKN A -1; Stop; }
}

class AE_Holster_Rifle : AE_HolsterGhost
{
	Default { Scale 0.15; }
	States { Spawn: HLRI A -1; Stop; }
}

class AE_Holster_Shotgun : AE_HolsterGhost
{
	Default { Scale 0.15; }
	States { Spawn: HLSH A -1; Stop; }
}

class AE_Holster_Flamer : AE_HolsterGhost
{
	Default { Scale 0.15; }
	States { Spawn: HLFL A -1; Stop; }
}

class AE_Holster_Smart : AE_HolsterGhost
{
	Default { Scale 0.15; }
	States { Spawn: HLSM A -1; Stop; }
}

class AE_Holster_Satchel : AE_HolsterGhost
{
	Default { Scale 0.1; }
	States { Spawn: HLSA A -1; Stop; }
}

class AE_Holsters abstract
{
	clearscope static int Count() { return 7; }

	clearscope static double PosF(int i)
	{
		static const double v[] = { 2.0, 2.0, -14.0, -14.0, -26.0, -26.0, -20.0 };	// PATCHED BY HAND 2026-10-22: satchel 14 cm in FRONT of the chest filled the view; now on the lower back
		return i >= 0 && i < v.Size() ? v[i] : 0;
	}

	clearscope static double PosL(int i)
	{
		static const double v[] = { -20.0, 20.0, -22.0, 22.0, 10.0, -10.0, 0.0 };
		return i >= 0 && i < v.Size() ? v[i] : 0;
	}

	clearscope static double PosU(int i)
	{
		static const double v[] = { -58.0, -55.0, -10.0, -10.0, -32.0, -32.0, -40.0 };
		return i >= 0 && i < v.Size() ? v[i] : 0;
	}

	clearscope static double Roll(int i)
	{
		static const double v[] = { 0.0, 0.0, -25.0, 25.0, 0.0, 0.0, 0.0 };
		return i >= 0 && i < v.Size() ? v[i] : 0;
	}

	clearscope static Name Ghost(int i)
	{
		static const Name v[] = { 'AE_Holster_Pistol', 'AE_Holster_Knife', 'AE_Holster_Rifle', 'AE_Holster_Shotgun', 'AE_Holster_Flamer', 'AE_Holster_Smart', 'AE_Holster_Satchel' };
		return i >= 0 && i < v.Size() ? v[i] : 'None';
	}

	// the holstered weapon for this slot: the first one the player has
	clearscope static Weapon Held(PlayerPawn mo, int i)
	{
		switch (i)
		{
		case 0:
			if (mo.FindInventory('M4A3Pistol_3D')) return Weapon(mo.FindInventory('M4A3Pistol_3D'));
			if (mo.FindInventory('MercPistol_3D')) return Weapon(mo.FindInventory('MercPistol_3D'));
			if (mo.FindInventory('SynthPistol_3D')) return Weapon(mo.FindInventory('SynthPistol_3D'));
			if (mo.FindInventory('YutaniPistol_3D')) return Weapon(mo.FindInventory('YutaniPistol_3D'));
			return null;
		case 1:
			if (mo.FindInventory('Knife_3D')) return Weapon(mo.FindInventory('Knife_3D'));
			if (mo.FindInventory('YutaniKnife_3D')) return Weapon(mo.FindInventory('YutaniKnife_3D'));
			return null;
		case 2:
			if (mo.FindInventory('PulseRifle_3D')) return Weapon(mo.FindInventory('PulseRifle_3D'));
			if (mo.FindInventory('YutaniRifle_3D')) return Weapon(mo.FindInventory('YutaniRifle_3D'));
			return null;
		case 3:
			if (mo.FindInventory('NewShotgun_3D')) return Weapon(mo.FindInventory('NewShotgun_3D'));
			if (mo.FindInventory('YutaniShotgun_3D')) return Weapon(mo.FindInventory('YutaniShotgun_3D'));
			return null;
		case 4:
			if (mo.FindInventory('M240Flamethrower_3D')) return Weapon(mo.FindInventory('M240Flamethrower_3D'));
			if (mo.FindInventory('YutaniFlamer_3D')) return Weapon(mo.FindInventory('YutaniFlamer_3D'));
			return null;
		case 5:
			if (mo.FindInventory('Smartgun_3D')) return Weapon(mo.FindInventory('Smartgun_3D'));
			if (mo.FindInventory('YutaniSmartgun_3D')) return Weapon(mo.FindInventory('YutaniSmartgun_3D'));
			return null;
		case 6:
			if (mo.FindInventory('Satcheler_3D')) return Weapon(mo.FindInventory('Satcheler_3D'));
			if (mo.FindInventory('YutaniSatchel_3D')) return Weapon(mo.FindInventory('YutaniSatchel_3D'));
			return null;
		}
		return null;
	}
}

