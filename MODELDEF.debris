// Enhanced-ballistics debris (zscript/rsq/ballistics.zs). Twelve pieces --
// chips, chunks and clods -- in three skins, picked by what the surface is
// made of (SURFACES.ae). Taken with the module from rs_brutal22weaponsq;
// they are generic geometry, nothing about them is BD22's.

Model RSQ_Debris
{
	Path "models/rsq/debris"
	Model 0 "chip1.md3"
	Skin 0 "debris_grey.png"
	Scale 1.6 1.6 1.6
	USEACTORPITCH
	FrameIndex QDBR A 0 0
}

