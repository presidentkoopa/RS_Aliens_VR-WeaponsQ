AddOptionMenu "OptionsMenu"
{
	StaticText " "
	Submenu "Aliens VR Weapons", "AE_Options"
}

OptionValue "AE_ReloadMode"
{
	0, "Stock"
	1, "VR"
}

OptionValue "AE_StartDual"
{
	0, "Normal"
	1, "Start with dual pistols"
}

OptionValue "AE_Ballistics"
{
	0, "Stock"
	1, "Enhanced"
}

OptionValue "AE_GrabWith"
{
	// FIXED 2026-10-23: "Use key" was 4 and "Either" 67108868, but at 9afc750
	// constants.zs:835-836 BT_USE is 1<<1 = 2 and BT_JUMP is 1<<2 = 4 -- so both rows
	// bound the ammo grab to JUMP. BT_OFFHANDATTACK is 1<<26 = 67108864.
	// 2026-10-23: these were usercmd BUTTON MASKS, which is the wrong shape for this choice.
	// "Either" let the grip and the trigger both grab, and "Use key" put BT_USE in the mask,
	// which grabs a magazine AND opens the door behind it. 1.92 picks ONE input and, for the
	// Use key, intercepts it for the duration of the reload. Values are rsr_grab_with now.
	0, "Off hand trigger"
	1, "Off hand grip"
	2, "Use key"
}

