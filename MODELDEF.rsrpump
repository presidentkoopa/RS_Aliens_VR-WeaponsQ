// RSR-PUMP: Ermac's one-shell hold (ammo_hand frame 1) without his shell: the gun's own shell is
// drawn in it on layer 2210 (rsr/rsr_pump.zs). ammo_hand.md3 is already in the packs (models/rsq).
Model RSQ_Hands
{
	Path "models/rsq"
	Model 0 "ammo_hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0000 -30.0000 0.0
	ZOffset -7.0000
	FrameIndex RQUN A 0 1
}
