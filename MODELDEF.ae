// Aliens Eradication VR hands. Poses: Ermac, Force Unleashed / Rusted Legacy
// (MIT code; the art is "for education purpose only" -- do not ship the glove publicly).
// Generated by tool/hands/ae_gen.py from ae_fits.json. Do not edit by hand.
//
// Three blocks for the whole set: the hands ride helper actors, not the weapons,
// so per-gun placement is in zscript/rsq/handtable.zs, not here.

// gun hand + support hand, both on the MAIN controller
Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQGS A 0 0	// Ermac hand.md3 frame 0
	FrameIndex RQGS B 0 1	// Ermac hand.md3 frame 1
	FrameIndex RQGS C 0 2	// Ermac hand.md3 frame 19
	FrameIndex RQGS D 0 3	// Ermac hand.md3 frame 29
	FrameIndex RQGS E 0 4	// Ermac hand.md3 frame 30
	FrameIndex RQGS F 0 5	// Ermac hand.md3 frame 106
	FrameIndex RQGT A 0 6	// index finger on the trigger
	FrameIndex RQGU A 0 7	// trigger squeezed
	FrameIndex RQGT B 0 8	// index finger on the trigger
	FrameIndex RQGU B 0 9	// trigger squeezed
	FrameIndex RQGT C 0 10	// index finger on the trigger
	FrameIndex RQGU C 0 11	// trigger squeezed
	FrameIndex RQGT D 0 12	// index finger on the trigger
	FrameIndex RQGU D 0 13	// trigger squeezed
	FrameIndex RQGT E 0 14	// index finger on the trigger
	FrameIndex RQGU E 0 15	// trigger squeezed
}

Model RSQ_GunSide
{
	Path "models/rsq"
	Model 0 "hand2.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQSP A 0 0	// Ermac hand2.md3 frame 4
	FrameIndex RQSP B 0 1	// Ermac hand2.md3 frame 15
	FrameIndex RQSP C 0 2	// Ermac hand2.md3 frame 91
}

// the free hand, on the OFF controller (open / fist)
Model RSQ_Hands
{
	Path "models/rsq"
	Model 0 "hand.md3"
	Skin 0 "hand.png"
	Scale -1.0 1.0 1.0
	Offset 0.0 -24.0 -10.0
	FrameIndex RQHN A 0 0
	FrameIndex RQHN H 0 1
}


// 2026-10-22 PULSE RIFLE AMMO COUNTER (owner: "textures 00..99 that change as the gun fires").
// A quad (tools/md3_counter.py) lying on the receiver's counter window, found by the window's
// UV box on m41a.png; one skin per value, ONE BLOCK PER VALUE: the MODELDEF parser keeps every
// slot's frame across the FrameIndex lines of a block, so 100 slots in one block drew all 100
// quads on top of each other (always "00"). Drawn as layer RSQ_Layers.COUNTER (2130) with the
// gun's own placement, so model space is the gun's; zscript/rsq/counter.zs picks the state.
Model RSQ_GunSide
{
	Path "models/weapons/rifle"
	Model 0 "counter.md3"
	Skin 0 "counter/c00.png"
	Scale -1.1 1.1 1.1
