ACTOR AE_Off_MercPistol : MercPistol_3D
{
	Tag "Off-hand Merc pistol"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON
	Weapon.AmmoType1 "AE_MercPistolMagOff"		// its own magazine
	Weapon.AmmoType2 "PistolClip"		// the shared reserve

	// GENERATED from MercPistol_3D: its whole state machine with PistolLoaded -> AE_MercPistolMagOff (8 swapped).
	// Inheriting the parent's states instead would load the PARENT's magazine.
	States
	{
  Ready:
    MM91 A 0 ACS_NamedExecuteAlways("LOADDOWN", 0, 20, 56)
    //MM91 A 0 A_JumpifInventory("NormalStance", 1, "RealReady")
	//TNT1 A 0 A_JumpifInventory("IsSight", 1, "SightReady")	 
    //Loop
  RealReady:
    //TNT1 A 0 Bright A_ZoomFactor(1.0)
	MM91 A 0 A_SetSpeed (0.7)
    //TNT1 A 0 A_SetCrosshair(0)
    MM91 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
     Goto Ready
	 /*
  SightReady:
     TNT1 A 0 Bright A_ZoomFactor(1.4)
	 TNT1 A 0 A_SetSpeed (0.35)
     TNT1 A 0 A_SetCrosshair(8)
     PISI A 1 Bright A_WeaponReady(WRF_ALLOWRELOAD)
     Goto Ready
	 */
  Deselect:
    //TNT1 A 0 Bright A_ZoomFactor(1.0)
	MM91 A 0 A_SetSpeed (0.7)
	//TNT1 A 0 A_SetCrosshair(0)
	//MM91 A 0 A_TakeInventory("NormalStance", 1)
    //TNT1 A 0 A_TakeInventory("IsSight", 1)
    MM91 A 1 A_Lower(12)
    Loop
  Select:
    //MM91 A 0 A_GiveInventory("NormalStance", 1)
	//TNT1 A 0 A_TakeInventory("IsSight", 1)
    MM91 A 1 A_Raise(12)
    Loop
	EmptyReady:
	MM91 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
	Loop
	Dryfire:
    //TNT1 A 0 A_JumpifInventory("IsSight", 1, "IronSightDryFire")
	MM91 A 2 A_PlaySound ("DRYFIRE")
	Goto Reload
	/*
  IronSightDryFire:
     PISI A 15 Bright A_PlaySound("DRYFIRE", 1)
     Goto Reload
	 */
  Fire:
	/*
    TNT1 A 0 A_JumpIfnoAmmo("Dryfire")
	TNT1 A 0 A_JumpifInventory("IsSight", 1, "SightFire")
	TNT1 A 0 A_PlaySound ("COLTFIRE", 1, 0.4)
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_FireCustomMissile("DummyProjectile1", 0, 0, 0, 0, 0, 0)
	MM91 B 2 Bright A_FireProjectile ("MerPistol", random(-1, 1), -1, 0, 8, 0, random(-1, 1))
    MM91 C 1 Bright A_Light(3)
	MM91 D 1
	TNT1 A 0 A_Gunflash
	MM91 A 1 A_WeaponReady
	*/
    MM91 A 0 A_JumpIfnoAmmo("Dryfire")
	MM91 A 0 A_Gunflash
	MM91 A 0 A_PlaySound ("COLTFIRE", 1, 0.4)
    MM91 A 0 A_AlertMonsters
    MM91 A 0 A_FireCustomMissile("DummyProjectile1", 0, 0, 0, 0, 0, 0)
    MM91 B 1 Bright A_Light(3)
	MM91 C 1 Bright A_FireProjectile ("ColPistol", 0, -1, 0, 8, 0, 0)
    MM91 DE 1
	MM91 F 1
	"####" # 0 A_JumpIf(GetCVAR("avw_weapons")==0, "Ready")
	"####" # 0 A_FireProjectile("GunBarrelSmoke",0,0,0,0,FPF_NOAUTOAIM,0)
    Goto Ready
	/*
  SightFire:
     TNT1 A 0 A_JumpIfnoAmmo("Dryfire")
	 TNT1 A 0 A_PlaySound ("COLTFIRE", 1, 0.45)
     TNT1 A 0 A_AlertMonsters
     TNT1 A 0 A_FireCustomMissile("DummyProjectile1", 0, 0, 0, 0, 0, 0)
	 PISI B 2 Bright A_FireProjectile ("MerPistol", 0, -1, 0, 8, 0, 3)
	 TNT1 A 0 A_SetAngle(frandom(0, -0.2) + angle)
     TNT1 A 0 A_SetPitch(-0.25 + pitch)
	 PISI C 1 Bright A_Gunflash
	 PISI D 1 Bright A_WeaponReady
     Goto Ready
	 */
	Reload:
  MM91 A 0 A_JumpIfInventory("AE_MercPistolMagOff", 12, 2)
  MM91 A 0 A_JumpIfInventory("PistolClip", 1, "ReloadWork")
  MM91 A 0
  Goto Ready
  ReloadWork:
  	MM91 A 0 A_GiveInventory("RSR_Go", 1)
  	Goto RSR_Start
  ReloadWork_Stock:
	//MM91 A 0 A_PlaySound("PTCLIPOU")
	//TNT1 A 0 Bright A_ZoomFactor(1.0)
	MM91 A 0 A_SetSpeed (0.7)
    //TNT1 A 0 A_SetCrosshair(0)
	//MM91 A 0 A_GiveInventory("NormalStance", 1)
	//TNT1 A 0 A_TakeInventory("IsSight", 1)
	//MM91 E 6
	MM91 GHI 1
	ReloadLoop:
    MM91 A 0 A_TakeInventory("PistolClip", 1)
    MM91 A 0 A_GiveInventory("AE_MercPistolMagOff", 1)
    MM91 A 0 A_JumpIfInventory("AE_MercPistolMagOff", 12, "ReloadFinish")
    MM91 A 0 A_JumpIfInventory("PistolClip", 1, "ReloadLoop")
	ReloadFinish:
	/*
	TNT1 A 0 A_PlaySound("PTCLIPIN")
    TNT1 A 0 
	MM91 F 7
	MM91 G 6
	MM91 A 5
	*/
	MM91 J 1 A_PlaySound("PTCLIPOU")
    MM91 K 1 
    MM91 L 6
	MM91 M 6
	MM91 N 1
	MM91 O 1 A_PlaySound("PTCLIPIN")
	MM91 PQRST 1
	Goto Ready
  Flash:
	TNT1 A 0 A_JumpIf(GetCVAR("avw_tracers")==false, 2)
	TNT1 A 0 A_FireProjectile("BulletTracer",random(-1,1),0,0,0,FPF_NOAUTOAIM,random(-1,1))
	TNT1 A 0 A_JumpIf(GetCVAR("avw_weapons_mf")==1, "MuzzleFlash")
    TNT1 A 0 Bright A_Light1
    Goto LightDone
  MuzzleFlash:
	TNT1 A 1
    PSMF AB 1 Bright A_Light1
    TNT1 A 0 A_Light0
	Stop
  Spawn:
	M4A3 A 0 A_JumpIf(GetCVAR("avw_pickupmodel")==1, "Spawn3D")
    M4A3 A 1
    Loop
  Spawn3D:
	M4A3 A 0 A_JumpIf(GetCVAR("avw_pickupmodel")==0, "Spawn")
    M4A3 P 1 Bright
    Loop
  
	// RSR: real VR reload (zscript/rsr/vreload.zs, tools/rsr_patch_ae.py AE_GUNS).
	// Not in VR, or with real reload off, RSR_Start falls through to the
	// set's own canned reload and nothing below runs.
	RSR_Start:
		MM91 A 0 A_TakeInventory("RSR_Go", 1)
		MM91 A 0 A_GiveInventory("RSR_Start", 1)
		MM91 A 0 A_JumpIfInventory("RSR_Go", 1, "RSR_Out")
		Goto ReloadWork_Stock
	RSR_Out:
		MM91 A 0 A_TakeInventory("RSR_Go", 1)
		MM91 A 0 A_JumpIfInventory("RSR_NoMag_MercPistol", 1, "RSR_Wait")	// no magazine in the gun
		MM91 A 0 A_JumpIfInventory("RSR_Charge", 1, "RSR_Filled")	// magazine in, handle still due
		MM91 A 0 A_GiveInventory("RSR_MagOut", 1)	// the magazine drops out (its own sound)
	RSR_Unload:	// the rounds are held aside and come back when a magazine is home, so
				// the count ends where the gun's own reload would have ended it
		MM91 A 0 A_JumpIfInventory("AE_MercPistolMagOff", 1, "RSR_Unload1")
		MM91 A 0 A_GiveInventory("RSR_NoMag_MercPistol", 1)
		Goto RSR_Wait
	RSR_Unload1:
		MM91 A 0 A_TakeInventory("AE_MercPistolMagOff", 1)
		MM91 A 0 A_GiveInventory("RSR_Held_MercPistol_3D", 1)
		Goto RSR_Unload
	RSR_Wait:		// the gun as the script shows it ("####" "#"); the script runs every tic
		"####" "#" 1 A_WeaponReady(WRF_NOBOB|WRF_NOFIRE)
		"####" "#" 0 A_GiveInventory("RSR_Tick", 1)
		"####" "#" 0 A_JumpIfInventory("RSR_Seated", 1, "RSR_Fill")
		"####" "#" 0 A_JumpIfInventory("RSR_Done", 1, "RSR_Done")
		Goto RSR_Wait
	RSR_Fill:	// the magazine is home: the gun's own fill loop, its own items
		MM91 A 0 A_TakeInventory("RSR_Seated", 1)
		MM91 A 0 A_TakeInventory("RSR_NoMag_MercPistol", 1)
	RSR_Return:	// the held rounds first
		MM91 A 0 A_JumpIfInventory("RSR_Held_MercPistol_3D", 1, "RSR_Return1")
		Goto RSR_FillGo
	RSR_Return1:
		MM91 A 0 A_TakeInventory("RSR_Held_MercPistol_3D", 1)
		MM91 A 0 A_GiveInventory("AE_MercPistolMagOff", 1)
		Goto RSR_Return
	RSR_FillGo:
		MM91 A 0 A_GiveInventory("RSR_Charge", 1)	// the handle is due (vreload.zs: ChargeToken)
		Goto RSR_FillA
	RSR_FillA:
		MM91 A 0 A_JumpIfInventory("AE_MercPistolMagOff", 12, "RSR_Filled")
		MM91 A 0 A_JumpIfInventory("PistolClip", 1, "RSR_FillAa")
		Goto RSR_Filled
	RSR_FillAa:
		MM91 A 0 A_GiveInventory("AE_MercPistolMagOff", 1)
		MM91 A 0 A_TakeInventory("PistolClip", 1, TIF_NOTAKEINFINITE)
		Goto RSR_FillA
	RSR_Filled:
		MM91 A 0 A_GiveInventory("RSR_Filled", 1)	// the script: the handle if due, else done
		Goto RSR_Wait
	RSR_Done:
		MM91 A 0 A_TakeInventory("RSR_Done", 1)
		MM91 A 0 A_TakeInventory("RSR_Charge", 1)
		Goto Ready
	}
}

ACTOR AE_SynthPistolMagOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 30		// the cap in SynthPistol_3D's own reload loop
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 30
	+INVENTORY.IGNORESKILL
}

