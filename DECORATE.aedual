// GENERATED by tool/hands/ae_dual_gen.py: the off-hand copies of the
// Aliens guns. Do not edit by hand.
//
// Each copy is its gun, renamed, with its OWN magazine, living in the
// off hand only. The reserve is shared with the main-hand gun. This
// follows rs_brutal22weaponsq's DECORATE.rsqdual exactly, except that
// the ammo slots are the other way round: Aliens puts the magazine in
// AmmoType1 and the reserve in AmmoType2 (its own variants declare
// Weapon.AmmoType2 "PistolClip"), where BD22 does the reverse.

ACTOR AE_M4A3PistolMagOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 12		// the cap in M4A3Pistol_3D's own reload loop
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 12
	+INVENTORY.IGNORESKILL
}

ACTOR AE_Off_M4A3Pistol : M4A3Pistol_3D
{
	Tag "Off-hand Pistol"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	+WEAPON.NOHANDSWITCH
	+WEAPON.CHEATNOTWEAPON
	Weapon.AmmoType1 "AE_M4A3PistolMagOff"		// its own magazine
	Weapon.AmmoType2 "PistolClip"		// the shared reserve
}

